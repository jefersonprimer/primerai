# ─── Postgres (docker compose) ────────────────────────────────────────────────
POSTGRES_USER=primerai
POSTGRES_PASSWORD=
POSTGRES_DB=primerai
POSTGRES_PORT=5432

# ─── Backend ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://primerai:senha@localhost:5432/primerai
PORT=8787
HOST=0.0.0.0
PUBLIC_URL=http://localhost:8787
CORS_ORIGIN=http://localhost:1420,http://localhost:8081,http://localhost:5173

# 32 bytes base64 — gere com: openssl rand -base64 32
# NUNCA comite essa chave. Sem ela a API não sobe.
PRIMERAI_MASTER_KEY=

# gere com: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# limite de temperatura/uso para o agent loop
AI_MAX_TOOL_ITERATIONS=12

# ─── Apps ─────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8787
EXPO_PUBLIC_API_URL=http://localhost:8787